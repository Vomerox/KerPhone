<Window x:Class="SoftPhone.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:SoftPhone.ViewModels"
        Title="KerPhone" Width="460" Height="740"
        MinWidth="420" MinHeight="620"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgDarkBrush}"
        FontFamily="Segoe UI"
        ResizeMode="CanResizeWithGrip"
        Icon="pack://application:,,,/Assets/kerphone.ico">

    <Window.DataContext>
        <vm:MainViewModel/>
    </Window.DataContext>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ════════ EN-TETE ════════ -->
        <Border Grid.Row="0" Padding="16,10">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Color="#FF1B2A41" Offset="0"/>
                    <GradientStop Color="#FF243B55" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Logo -->
                <Image Grid.Column="0" Source="pack://application:,,,/Assets/kerphone_logo.png"
                       Width="36" Height="36" Margin="0,0,10,0"
                       RenderOptions.BitmapScalingMode="HighQuality"
                       VerticalAlignment="Center"/>

                <!-- Titre + Statut -->
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock FontSize="19" FontWeight="Bold"
                               Foreground="{StaticResource TextPrimaryBrush}">
                        <Run Text="Ker" Foreground="{StaticResource AccentGoldBrush}"/><Run Text="Phone"/>
                    </TextBlock>
                    <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                        <Ellipse Width="8" Height="8" Margin="0,0,6,0" VerticalAlignment="Center">
                            <Ellipse.Fill>
                                <SolidColorBrush Color="{Binding RegistrationColor}"/>
                            </Ellipse.Fill>
                        </Ellipse>
                        <TextBlock Text="{Binding RegistrationStatus}" FontSize="12"
                                   Foreground="{StaticResource TextSecondaryBrush}"/>
                    </StackPanel>
                </StackPanel>

                <!-- Bouton deconnexion (visible si connecte) -->
                <Button Grid.Column="2" Style="{StaticResource HangupBtn}"
                        Command="{Binding DisconnectCommand}"
                        Content="Déconnexion" FontSize="12"
                        Padding="12,6" Height="34"
                        Visibility="{Binding IsRegistered, Converter={StaticResource BoolToVis}}"/>
            </Grid>
        </Border>

        <!-- ════════ CONTENU PRINCIPAL ════════ -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="10,8,22,8">

                <!-- ── Panneau de connexion (visible si NON connecte) ── -->
                <Border Visibility="{Binding IsRegistered, Converter={StaticResource BoolToVis},
                                     ConverterParameter=Invert}"
                        Background="{StaticResource BgCardBrush}"
                        CornerRadius="14" Padding="16" Margin="0,4,0,8">
                    <StackPanel>
                        <TextBlock Text="Connexion SIP" FontSize="16" FontWeight="SemiBold"
                                   Foreground="{StaticResource AccentGoldBrush}" Margin="0,0,0,14"/>

                        <!-- Serveur -->
                        <TextBlock Text="Serveur" FontSize="12"
                                   Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,4"/>
                        <TextBox Style="{StaticResource DarkTextBox}"
                                 Text="{Binding SipServer, UpdateSourceTrigger=PropertyChanged}"
                                 Tag="sip.exemple.fr"
                                 KeyDown="LoginField_KeyDown"/>

                        <!-- Port -->
                        <TextBlock Text="Port" FontSize="12"
                                   Foreground="{StaticResource TextMutedBrush}" Margin="0,10,0,4"/>
                        <TextBox Style="{StaticResource DarkTextBox}"
                                 Text="{Binding SipPort, UpdateSourceTrigger=PropertyChanged}"
                                 Width="100" HorizontalAlignment="Left"
                                 KeyDown="LoginField_KeyDown"/>

                        <!-- Identifiant -->
                        <TextBlock Text="Identifiant" FontSize="12"
                                   Foreground="{StaticResource TextMutedBrush}" Margin="0,10,0,4"/>
                        <TextBox Style="{StaticResource DarkTextBox}"
                                 Text="{Binding SipUser, UpdateSourceTrigger=PropertyChanged}"
                                 KeyDown="LoginField_KeyDown"/>

                        <!-- Mot de passe -->
                        <TextBlock Text="Mot de passe" FontSize="12"
                                   Foreground="{StaticResource TextMutedBrush}" Margin="0,10,0,4"/>
                        <PasswordBox x:Name="PasswordField" Style="{StaticResource DarkPasswordBox}"
                                     PasswordChanged="PasswordField_PasswordChanged"
                                     KeyDown="LoginField_KeyDown"/>

                        <!-- Bouton connexion -->
                        <Button Style="{StaticResource CallBtn}" Content="Connexion"
                                Command="{Binding ConnectCommand}" Margin="0,18,0,0"
                                IsEnabled="{Binding IsRegistered, Converter={StaticResource InverseBool}}"/>
                    </StackPanel>
                </Border>

                <!-- ── Appel entrant ── -->
                <Border Visibility="{Binding IsIncomingCall, Converter={StaticResource BoolToVis}}"
                        Background="{StaticResource BgCardBrush}"
                        CornerRadius="14" Padding="20" Margin="0,4,0,8">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="Appel entrant" FontSize="17" FontWeight="SemiBold"
                                   Foreground="{StaticResource AccentOrangeBrush}"
                                   HorizontalAlignment="Center" Margin="0,0,0,8"/>
                        <TextBlock Text="{Binding IncomingCallerInfo}" FontSize="14"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   HorizontalAlignment="Center" Margin="0,0,0,16"
                                   TextWrapping="Wrap" TextAlignment="Center"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <Button Style="{StaticResource CallBtn}" Content="Decrocher"
                                    Command="{Binding AnswerIncomingCommand}"
                                    Width="120" Margin="0,0,12,0"/>
                            <Button Style="{StaticResource HangupBtn}" Content="Refuser"
                                    Command="{Binding RejectIncomingCommand}" Width="120"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- ── Appel en cours ── -->
                <Border Visibility="{Binding IsInCall, Converter={StaticResource BoolToVis}}"
                        Background="{StaticResource BgCardBrush}"
                        CornerRadius="14" Padding="18" Margin="0,4,0,8">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="{Binding RemoteParty}" FontSize="20" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   HorizontalAlignment="Center" TextWrapping="Wrap"
                                   TextAlignment="Center"/>
                        <TextBlock Text="{Binding CallStatus}" FontSize="13"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   HorizontalAlignment="Center" Margin="0,4,0,0"/>
                        <TextBlock Text="{Binding CallDuration}" FontSize="32" FontWeight="Light"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   HorizontalAlignment="Center" Margin="0,10,0,14"/>

                        <!-- Boutons de controle -->
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,10">
                            <!-- Muet -->
                            <Button Style="{StaticResource ControlBtn}"
                                    Command="{Binding ToggleMuteCommand}"
                                    ToolTip="{Binding IsMuted, Converter={StaticResource MuteText}}">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="{Binding IsMuted, Converter={StaticResource MuteIcon}}"
                                               FontFamily="Segoe MDL2 Assets" FontSize="22"
                                               HorizontalAlignment="Center"
                                               Foreground="{StaticResource TextPrimaryBrush}"/>
                                    <TextBlock Text="{Binding IsMuted, Converter={StaticResource MuteText}}"
                                               FontSize="10" HorizontalAlignment="Center"
                                               Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Button>

                            <!-- Attente -->
                            <Button Style="{StaticResource ControlBtn}" Margin="18,0"
                                    Command="{Binding ToggleHoldCommand}"
                                    ToolTip="{Binding IsOnHold, Converter={StaticResource HoldText}}">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="{Binding IsOnHold, Converter={StaticResource HoldIcon}}"
                                               FontFamily="Segoe MDL2 Assets" FontSize="22"
                                               HorizontalAlignment="Center"
                                               Foreground="{StaticResource TextPrimaryBrush}"/>
                                    <TextBlock Text="{Binding IsOnHold, Converter={StaticResource HoldText}}"
                                               FontSize="10" HorizontalAlignment="Center"
                                               Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>

                        <!-- Volume -->
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,4,0,10">
                            <TextBlock Text="Volume" FontSize="11"
                                       Foreground="{StaticResource TextMutedBrush}"
                                       VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <Slider Width="160" Minimum="0" Maximum="2" Value="{Binding Volume}"
                                    TickFrequency="0.1" VerticalAlignment="Center"/>
                        </StackPanel>

                        <!-- Raccrocher -->
                        <Button Style="{StaticResource HangupBtn}" Content="Raccrocher"
                                Command="{Binding HangupCommand}" Width="170"/>
                    </StackPanel>
                </Border>

                <!-- ── Zone d'appel (visible uniquement si connecte) ── -->
                <StackPanel Visibility="{Binding IsRegistered, Converter={StaticResource BoolToVis}}">

                    <!-- Affichage du numero -->
                    <Border Background="{StaticResource BgCardBrush}" CornerRadius="12"
                            Padding="14,10" Margin="0,4,0,4"
                            Visibility="{Binding IsInCall, Converter={StaticResource BoolToVis},
                                         ConverterParameter=Invert}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" Style="{StaticResource DarkTextBox}"
                                     Text="{Binding DialNumber, UpdateSourceTrigger=PropertyChanged}"
                                     FontSize="26" FontWeight="Light" Background="Transparent"
                                     TextAlignment="Center" VerticalAlignment="Center"
                                     KeyDown="DialInput_KeyDown"/>
                            <Button Grid.Column="1" Style="{StaticResource BtnBase}"
                                    Command="{Binding BackspaceCommand}"
                                    Width="38" Height="38" Background="Transparent">
                                <TextBlock Text="&#x232B;" FontSize="20"
                                           Foreground="{StaticResource TextMutedBrush}"/>
                            </Button>
                        </Grid>
                    </Border>

                    <!-- Clavier numerique -->
                    <Grid HorizontalAlignment="Center" Margin="0,6,0,4"
                          Visibility="{Binding IsInCall, Converter={StaticResource BoolToVis},
                                       ConverterParameter=Invert}">
                        <Grid.RowDefinitions>
                            <RowDefinition/>
                            <RowDefinition/>
                            <RowDefinition/>
                            <RowDefinition/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/>
                            <ColumnDefinition/>
                            <ColumnDefinition/>
                        </Grid.ColumnDefinitions>

                        <Button Grid.Row="0" Grid.Column="0" Style="{StaticResource DialBtn}" Content="1"
                                Command="{Binding DialPadPressCommand}" CommandParameter="1"/>
                        <Button Grid.Row="0" Grid.Column="1" Style="{StaticResource DialBtn}" Content="2"
                                Command="{Binding DialPadPressCommand}" CommandParameter="2"/>
                        <Button Grid.Row="0" Grid.Column="2" Style="{StaticResource DialBtn}" Content="3"
                                Command="{Binding DialPadPressCommand}" CommandParameter="3"/>

                        <Button Grid.Row="1" Grid.Column="0" Style="{StaticResource DialBtn}" Content="4"
                                Command="{Binding DialPadPressCommand}" CommandParameter="4"/>
                        <Button Grid.Row="1" Grid.Column="1" Style="{StaticResource DialBtn}" Content="5"
                                Command="{Binding DialPadPressCommand}" CommandParameter="5"/>
                        <Button Grid.Row="1" Grid.Column="2" Style="{StaticResource DialBtn}" Content="6"
                                Command="{Binding DialPadPressCommand}" CommandParameter="6"/>

                        <Button Grid.Row="2" Grid.Column="0" Style="{StaticResource DialBtn}" Content="7"
                                Command="{Binding DialPadPressCommand}" CommandParameter="7"/>
                        <Button Grid.Row="2" Grid.Column="1" Style="{StaticResource DialBtn}" Content="8"
                                Command="{Binding DialPadPressCommand}" CommandParameter="8"/>
                        <Button Grid.Row="2" Grid.Column="2" Style="{StaticResource DialBtn}" Content="9"
                                Command="{Binding DialPadPressCommand}" CommandParameter="9"/>

                        <Button Grid.Row="3" Grid.Column="0" Style="{StaticResource DialBtn}" Content="*"
                                Command="{Binding DialPadPressCommand}" CommandParameter="*"/>
                        <Button Grid.Row="3" Grid.Column="1" Style="{StaticResource DialBtn}" Content="0"
                                Command="{Binding DialPadPressCommand}" CommandParameter="0"/>
                        <Button Grid.Row="3" Grid.Column="2" Style="{StaticResource DialBtn}" Content="#"
                                Command="{Binding DialPadPressCommand}" CommandParameter="#"/>
                    </Grid>

                    <!-- Bouton Appeler -->
                    <Button Style="{StaticResource CallBtn}" Content="Appeler"
                            Command="{Binding CallCommand}" Margin="0,6,0,4"
                            Visibility="{Binding IsInCall, Converter={StaticResource BoolToVis},
                                         ConverterParameter=Invert}"/>

                </StackPanel>

                <!-- ── Historique des appels (visible si connecte et pas en appel) ── -->
                <Border Background="{StaticResource BgCardBrush}" CornerRadius="12"
                        Padding="14" Margin="0,8,0,4"
                        Visibility="{Binding IsRegistered, Converter={StaticResource BoolToVis}}">
                    <StackPanel>
                        <TextBlock Text="Appels recents" FontSize="14" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,8"/>
                        <ItemsControl ItemsSource="{Binding CallHistory}" MaxHeight="150">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,3">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding Direction}"
                                                   FontSize="11" Width="60"
                                                   Foreground="{StaticResource TextMutedBrush}"/>
                                        <TextBlock Grid.Column="1" Text="{Binding Number}"
                                                   FontSize="12" TextTrimming="CharacterEllipsis"
                                                   Foreground="{StaticResource TextPrimaryBrush}"/>
                                        <TextBlock Grid.Column="2" Text="{Binding TimeDisplay}"
                                                   FontSize="11"
                                                   Foreground="{StaticResource TextMutedBrush}"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="Aucun appel recent" FontSize="12"
                                   Foreground="{StaticResource TextMutedBrush}"
                                   HorizontalAlignment="Center" Margin="0,8,0,0">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding CallHistory.Count}" Value="0">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <!-- ════════ BARRE DE STATUT ════════ -->
        <Border Grid.Row="2" Background="{StaticResource BgMediumBrush}" Padding="12,6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{Binding StatusMessage}" FontSize="11"
                           Foreground="{StaticResource AccentGoldBrush}"
                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                <!-- Bouton credits discret -->
                <Button Grid.Column="1" Style="{StaticResource CreditBtn}"
                        Command="{Binding ShowCreditsCommand}" VerticalAlignment="Center">
                    <TextBlock Text="&#xE946;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                               Foreground="{StaticResource AccentGoldBrush}"/>
                </Button>
            </Grid>
        </Border>

    </Grid>
</Window>
