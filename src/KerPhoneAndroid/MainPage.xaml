<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:KerPhoneAndroid.ViewModels"
             x:Class="KerPhoneAndroid.MainPage"
             x:DataType="vm:MainViewModel"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{StaticResource BgWhite}">

    <Grid RowDefinitions="*" Padding="0">

        <!-- ================================================================ -->
        <!-- PANNEAU CONNEXION (fond blanc, logo centre, champs simples)      -->
        <!-- ================================================================ -->
        <Grid IsVisible="{Binding ShowLoginPanel}"
              BackgroundColor="{StaticResource BgWhite}"
              Padding="0">
            <Grid RowDefinitions="Auto,*,Auto">

                <!-- Info icon en haut a droite -->
                <Button Grid.Row="0" Text="&#x24D8;"
                        Command="{Binding ShowCreditsCommand}"
                        BackgroundColor="Transparent"
                        TextColor="{StaticResource KerBlue}"
                        FontSize="22"
                        HorizontalOptions="End"
                        Margin="0,16,16,0" />

                <!-- Contenu centre -->
                <ScrollView Grid.Row="1" VerticalOptions="Center">
                    <VerticalStackLayout Spacing="16" Padding="40,0">

                        <!-- Logo -->
                        <Image Source="kerphone_logo.png"
                               HeightRequest="100" WidthRequest="100"
                               Aspect="AspectFit"
                               HorizontalOptions="Center"
                               Margin="0,0,0,4" />

                        <!-- Titre -->
                        <Label Text="KerPhone"
                               FontSize="28" FontFamily="OpenSansSemibold"
                               TextColor="{StaticResource KerBlue}"
                               HorizontalTextAlignment="Center"
                               Margin="0,0,0,16" />

                        <!-- Statut -->
                        <Label Text="{Binding StatusMessage}" FontSize="12"
                               TextColor="{StaticResource DangerRed}"
                               IsVisible="{Binding StatusMessage, Converter={StaticResource StringToBoolConverter}}"
                               HorizontalTextAlignment="Center" Margin="0,0,0,4" />

                        <!-- Champ Serveur SIP -->
                        <Border StrokeShape="RoundRectangle 10"
                                Stroke="{StaticResource BorderLight}"
                                StrokeThickness="1"
                                BackgroundColor="{StaticResource BgLight}"
                                Padding="0" HeightRequest="50">
                            <Entry Placeholder="Serveur SIP"
                                   Text="{Binding SipServer}"
                                   Keyboard="Url"
                                   ReturnType="Next"
                                   BackgroundColor="Transparent"
                                   Margin="12,0" />
                        </Border>

                        <!-- Champ Poste (identifiant) -->
                        <Border StrokeShape="RoundRectangle 10"
                                Stroke="{StaticResource BorderLight}"
                                StrokeThickness="1"
                                BackgroundColor="{StaticResource BgLight}"
                                Padding="0" HeightRequest="50">
                            <Entry Placeholder="Poste"
                                   Text="{Binding SipUser}"
                                   Keyboard="Plain"
                                   ReturnType="Next"
                                   BackgroundColor="Transparent"
                                   Margin="12,0" />
                        </Border>

                        <!-- Champ Port SIP -->
                        <Border StrokeShape="RoundRectangle 10"
                                Stroke="{StaticResource BorderLight}"
                                StrokeThickness="1"
                                BackgroundColor="{StaticResource BgLight}"
                                Padding="0" HeightRequest="50">
                            <Entry Placeholder="Port (défaut : 5060)"
                                   Text="{Binding SipPort}"
                                   Keyboard="Numeric"
                                   ReturnType="Next"
                                   BackgroundColor="Transparent"
                                   Margin="12,0" />
                        </Border>

                        <!-- Champ Mot de passe -->
                        <Border StrokeShape="RoundRectangle 10"
                                Stroke="{StaticResource BorderLight}"
                                StrokeThickness="1"
                                BackgroundColor="{StaticResource BgLight}"
                                Padding="0" HeightRequest="50">
                            <Entry Placeholder="Mot de passe"
                                   Text="{Binding SipPassword}"
                                   IsPassword="True"
                                   ReturnType="Go"
                                   BackgroundColor="Transparent"
                                   Margin="12,0"
                                   x:Name="PasswordEntry" />
                        </Border>

                        <!-- Bouton Connexion -->
                        <Button Text="Connexion"
                                Style="{StaticResource PrimaryButton}"
                                Command="{Binding ConnectCommand}"
                                IsEnabled="{Binding IsConnecting, Converter={StaticResource InvertedBoolConverter}}"
                                Margin="0,8,0,0" />

                        <!-- Loading -->
                        <ActivityIndicator IsRunning="{Binding IsConnecting}"
                                           IsVisible="{Binding IsConnecting}"
                                           Color="{StaticResource KerBlue}"
                                           HorizontalOptions="Center" />

                    </VerticalStackLayout>
                </ScrollView>
            </Grid>
        </Grid>

        <!-- ================================================================ -->
        <!-- PANNEAU CLAVIER (header + numero + dialpad + bouton appeler)     -->
        <!-- ================================================================ -->
        <Grid IsVisible="{Binding ShowDialPad}"
              BackgroundColor="{StaticResource BgWhite}"
              RowDefinitions="Auto,*"
              Padding="0">

            <!-- Header -->
            <Grid Grid.Row="0" BackgroundColor="{StaticResource BgHeader}"
                  Padding="12,10" ColumnDefinitions="Auto,Auto,*,Auto"
                  Shadow="{OnPlatform Default={x:Null}}">

                <Image Grid.Column="0" Source="kerphone_logo.png"
                       HeightRequest="30" WidthRequest="30"
                       Aspect="AspectFit" VerticalOptions="Center" />

                <VerticalStackLayout Grid.Column="1" Margin="8,0,0,0" VerticalOptions="Center">
                    <Label Text="KerPhone" FontSize="16" FontFamily="OpenSansSemibold"
                           TextColor="{StaticResource TextDark}" />
                    <Label Text="{Binding RegistrationStatus}" FontSize="10"
                           TextColor="{StaticResource SuccessGreen}" />
                </VerticalStackLayout>

                <Button Grid.Column="3" Text="&#x2716; Deconnexion"
                        Command="{Binding DisconnectCommand}"
                        BackgroundColor="{StaticResource DangerRed}"
                        TextColor="White"
                        CornerRadius="8"
                        FontSize="11" FontFamily="OpenSansSemibold"
                        HeightRequest="32" Padding="10,0"
                        VerticalOptions="Center" />
            </Grid>

            <!-- Contenu clavier -->
            <ScrollView Grid.Row="1">
                <VerticalStackLayout Spacing="8" Padding="20,16">

                    <!-- Message de statut -->
                    <Label Text="{Binding StatusMessage}" FontSize="12"
                           TextColor="{StaticResource TextMuted}"
                           IsVisible="{Binding StatusMessage, Converter={StaticResource StringToBoolConverter}}"
                           HorizontalTextAlignment="Center" />

                    <!-- Affichage du numero -->
                    <Grid ColumnDefinitions="*,Auto" Margin="0,8,0,0">
                        <Label Grid.Column="0"
                               Text="{Binding DialNumber}"
                               FontSize="28" FontFamily="OpenSansSemibold"
                               TextColor="{StaticResource TextDark}"
                               HorizontalTextAlignment="Center"
                               VerticalOptions="Center"
                               MinimumHeightRequest="40" />
                        <Button Grid.Column="1" Text="&#x232B;"
                                Command="{Binding BackspaceCommand}"
                                BackgroundColor="Transparent"
                                TextColor="{StaticResource TextMuted}"
                                FontSize="24" WidthRequest="50" HeightRequest="50"
                                VerticalOptions="Center" />
                    </Grid>

                    <!-- Separateur -->
                    <BoxView HeightRequest="1" BackgroundColor="{StaticResource BorderLight}" Margin="0,4" />

                    <!-- Pave numerique avec lettres -->
                    <Grid ColumnDefinitions="*,*,*" RowDefinitions="72,72,72,72"
                          ColumnSpacing="12" RowSpacing="10"
                          HorizontalOptions="Center" Margin="0,4">

                        <!-- Ligne 1: 1, 2 ABC, 3 DEF -->
                        <Border Grid.Row="0" Grid.Column="0" StrokeShape="RoundRectangle 14" Stroke="Transparent"
                                BackgroundColor="{StaticResource DialBg}" HeightRequest="64" WidthRequest="90">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding DialPadPressCommand}" CommandParameter="1" />
                            </Border.GestureRecognizers>
                            <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center" Spacing="0">
                                <Label Text="1" FontSize="26" FontFamily="OpenSansSemibold" TextColor="{StaticResource DialText}" HorizontalTextAlignment="Center" />
                                <Label Text=" " FontSize="9" TextColor="{StaticResource DialSub}" HorizontalTextAlignment="Center" />
                            </VerticalStackLayout>
                        </Border>
                        <Border Grid.Row="0" Grid.Column="1" StrokeShape="RoundRectangle 14" Stroke="Transparent"
                                BackgroundColor="{StaticResource DialBg}" HeightRequest="64" WidthRequest="90">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding DialPadPressCommand}" CommandParameter="2" />
                            </Border.GestureRecognizers>
                            <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center" Spacing="0">
                                <Label Text="2" FontSize="26" FontFamily="OpenSansSemibold" TextColor="{StaticResource DialText}" HorizontalTextAlignment="Center" />
                                <Label Text="ABC" FontSize="9" TextColor="{StaticResource DialSub}" HorizontalTextAlignment="Center" />
                            </VerticalStackLayout>
                        </Border>
                        <Border Grid.Row="0" Grid.Column="2" StrokeShape="RoundRectangle 14" Stroke="Transparent"
                                BackgroundColor="{StaticResource DialBg}" HeightRequest="64" WidthRequest="90">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding DialPadPressCommand}" CommandParameter="3" />
                            </Border.GestureRecognizers>
                            <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center" Spacing="0">
                                <Label Text="3" FontSize="26" FontFamily="OpenSansSemibold" TextColor="{StaticResource DialText}" HorizontalTextAlignment="Center" />
                                <Label Text="DEF" FontSize="9" TextColor="{StaticResource DialSub}" HorizontalTextAlignment="Center" />
                            </VerticalStackLayout>
                        </Border>

                        <!-- Ligne 2: 4 GHI, 5 JKL, 6 MNO -->
                        <Border Grid.Row="1" Grid.Column="0" StrokeShape="RoundRectangle 14" Stroke="Transparent"
                                BackgroundColor="{StaticResource DialBg}" HeightRequest="64" WidthRequest="90">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding DialPadPressCommand}" CommandParameter="4" />
                            </Border.GestureRecognizers>
                            <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center" Spacing="0">
                                <Label Text="4" FontSize="26" FontFamily="OpenSansSemibold" TextColor="{StaticResource DialText}" HorizontalTextAlignment="Center" />
                                <Label Text="GHI" FontSize="9" TextColor="{StaticResource DialSub}" HorizontalTextAlignment="Center" />
                            </VerticalStackLayout>
                        </Border>
                        <Border Grid.Row="1" Grid.Column="1" StrokeShape="RoundRectangle 14" Stroke="Transparent"
                                BackgroundColor="{StaticResource DialBg}" HeightRequest="64" WidthRequest="90">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding DialPadPressCommand}" CommandParameter="5" />
                            </Border.GestureRecognizers>
                            <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center" Spacing="0">
                                <Label Text="5" FontSize="26" FontFamily="OpenSansSemibold" TextColor="{StaticResource DialText}" HorizontalTextAlignment="Center" />
                                <Label Text="JKL" FontSize="9" TextColor="{StaticResource DialSub}" HorizontalTextAlignment="Center" />
                            </VerticalStackLayout>
                        </Border>
                        <Border Grid.Row="1" Grid.Column="2" StrokeShape="RoundRectangle 14" Stroke="Transparent"
                                BackgroundColor="{StaticResource DialBg}" HeightRequest="64" WidthRequest="90">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding DialPadPressCommand}" CommandParameter="6" />
                            </Border.GestureRecognizers>
                            <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center" Spacing="0">
                                <Label Text="6" FontSize="26" FontFamily="OpenSansSemibold" TextColor="{StaticResource DialText}" HorizontalTextAlignment="Center" />
                                <Label Text="MNO" FontSize="9" TextColor="{StaticResource DialSub}" HorizontalTextAlignment="Center" />
                            </VerticalStackLayout>
                        </Border>

                        <!-- Ligne 3: 7 PQRS, 8 TUV, 9 WXYZ -->
                        <Border Grid.Row="2" Grid.Column="0" StrokeShape="RoundRectangle 14" Stroke="Transparent"
                                BackgroundColor="{StaticResource DialBg}" HeightRequest="64" WidthRequest="90">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding DialPadPressCommand}" CommandParameter="7" />
                            </Border.GestureRecognizers>
                            <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center" Spacing="0">
                                <Label Text="7" FontSize="26" FontFamily="OpenSansSemibold" TextColor="{StaticResource DialText}" HorizontalTextAlignment="Center" />
                                <Label Text="PQRS" FontSize="9" TextColor="{StaticResource DialSub}" HorizontalTextAlignment="Center" />
                            </VerticalStackLayout>
                        </Border>
                        <Border Grid.Row="2" Grid.Column="1" StrokeShape="RoundRectangle 14" Stroke="Transparent"
                                BackgroundColor="{StaticResource DialBg}" HeightRequest="64" WidthRequest="90">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding DialPadPressCommand}" CommandParameter="8" />
                            </Border.GestureRecognizers>
                            <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center" Spacing="0">
                                <Label Text="8" FontSize="26" FontFamily="OpenSansSemibold" TextColor="{StaticResource DialText}" HorizontalTextAlignment="Center" />
                                <Label Text="TUV" FontSize="9" TextColor="{StaticResource DialSub}" HorizontalTextAlignment="Center" />
                            </VerticalStackLayout>
                        </Border>
                        <Border Grid.Row="2" Grid.Column="2" StrokeShape="RoundRectangle 14" Stroke="Transparent"
                                BackgroundColor="{StaticResource DialBg}" HeightRequest="64" WidthRequest="90">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding DialPadPressCommand}" CommandParameter="9" />
                            </Border.GestureRecognizers>
                            <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center" Spacing="0">
                                <Label Text="9" FontSize="26" FontFamily="OpenSansSemibold" TextColor="{StaticResource DialText}" HorizontalTextAlignment="Center" />
                                <Label Text="WXYZ" FontSize="9" TextColor="{StaticResource DialSub}" HorizontalTextAlignment="Center" />
                            </VerticalStackLayout>
                        </Border>

                        <!-- Ligne 4: *, 0, # -->
                        <Border Grid.Row="3" Grid.Column="0" StrokeShape="RoundRectangle 14" Stroke="Transparent"
                                BackgroundColor="{StaticResource DialBg}" HeightRequest="64" WidthRequest="90">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding DialPadPressCommand}" CommandParameter="*" />
                            </Border.GestureRecognizers>
                            <Label Text="*" FontSize="30" FontFamily="OpenSansSemibold" TextColor="{StaticResource DialText}"
                                   HorizontalTextAlignment="Center" VerticalTextAlignment="Center"
                                   HorizontalOptions="Center" VerticalOptions="Center" />
                        </Border>
                        <Border Grid.Row="3" Grid.Column="1" StrokeShape="RoundRectangle 14" Stroke="Transparent"
                                BackgroundColor="{StaticResource DialBg}" HeightRequest="64" WidthRequest="90">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding DialPadPressCommand}" CommandParameter="0" />
                            </Border.GestureRecognizers>
                            <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center" Spacing="0">
                                <Label Text="0" FontSize="26" FontFamily="OpenSansSemibold" TextColor="{StaticResource DialText}" HorizontalTextAlignment="Center" />
                                <Label Text="+" FontSize="9" TextColor="{StaticResource DialSub}" HorizontalTextAlignment="Center" />
                            </VerticalStackLayout>
                        </Border>
                        <Border Grid.Row="3" Grid.Column="2" StrokeShape="RoundRectangle 14" Stroke="Transparent"
                                BackgroundColor="{StaticResource DialBg}" HeightRequest="64" WidthRequest="90">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding DialPadPressCommand}" CommandParameter="#" />
                            </Border.GestureRecognizers>
                            <Label Text="#" FontSize="26" FontFamily="OpenSansSemibold" TextColor="{StaticResource DialText}"
                                   HorizontalTextAlignment="Center" VerticalTextAlignment="Center"
                                   HorizontalOptions="Center" VerticalOptions="Center" />
                        </Border>
                    </Grid>

                    <!-- Bouton Appeler (bleu avec icone telephone) -->
                    <Button Text="&#x1F4DE;  Appeler"
                            Style="{StaticResource PrimaryButton}"
                            Command="{Binding CallCommand}"
                            Margin="0,8,0,0" />

                    <!-- Historique -->
                    <Label Text="Historique" FontSize="15" FontFamily="OpenSansSemibold"
                           TextColor="{StaticResource TextDark}" Margin="0,12,0,4"
                           IsVisible="{Binding CallHistory.Count, Converter={StaticResource StringToBoolConverter}}" />

                    <CollectionView ItemsSource="{Binding CallHistory}"
                                    SelectionMode="Single"
                                    SelectionChangedCommand="{Binding DialFromHistoryCommand}"
                                    SelectionChangedCommandParameter="{Binding SelectedItem, Source={RelativeSource Self}}">
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="vm:CallHistoryEntry">
                                <Grid ColumnDefinitions="Auto,*,Auto" Padding="4,10"
                                      BackgroundColor="Transparent">
                                    <Label Grid.Column="0" Text="{Binding Direction}"
                                           FontSize="11" TextColor="{StaticResource KerBlue}"
                                           VerticalOptions="Center" WidthRequest="55" />
                                    <Label Grid.Column="1" Text="{Binding Number}"
                                           FontSize="14" FontFamily="OpenSansSemibold"
                                           TextColor="{StaticResource TextDark}" VerticalOptions="Center" />
                                    <Label Grid.Column="2" Text="{Binding TimeDisplay}"
                                           FontSize="11" TextColor="{StaticResource TextMuted}"
                                           VerticalOptions="Center" />
                                </Grid>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>

                </VerticalStackLayout>
            </ScrollView>
        </Grid>

        <!-- ================================================================ -->
        <!-- APPEL ENTRANT                                                     -->
        <!-- ================================================================ -->
        <Grid IsVisible="{Binding ShowIncomingCall}"
              BackgroundColor="{StaticResource BgWhite}"
              Padding="0">
            <VerticalStackLayout Spacing="20" VerticalOptions="Center" HorizontalOptions="Center"
                                 Padding="40">

                <Image Source="kerphone_logo.png"
                       HeightRequest="100" WidthRequest="100"
                       Aspect="AspectFit" HorizontalOptions="Center" />

                <Label Text="Appel entrant" FontSize="18"
                       TextColor="{StaticResource KerBlue}"
                       HorizontalTextAlignment="Center" />

                <Label Text="{Binding IncomingCallerInfo}" FontSize="28"
                       FontFamily="OpenSansSemibold"
                       TextColor="{StaticResource TextDark}"
                       HorizontalTextAlignment="Center" />

                <HorizontalStackLayout Spacing="16" HorizontalOptions="Center" Margin="0,20,0,0">
                    <Button Text="Répondre"
                            BackgroundColor="{StaticResource SuccessGreen}"
                            TextColor="White" CornerRadius="28"
                            HeightRequest="56" MinimumWidthRequest="130"
                            FontFamily="OpenSansSemibold" FontSize="15"
                            Command="{Binding AnswerIncomingCommand}" />
                    <Button Text="Refuser"
                            Style="{StaticResource DangerButton}"
                            Command="{Binding RejectIncomingCommand}" />
                </HorizontalStackLayout>
            </VerticalStackLayout>
        </Grid>

        <!-- ================================================================ -->
        <!-- APPEL EN COURS (fond blanc, design epure)                        -->
        <!-- ================================================================ -->
        <Grid IsVisible="{Binding ShowActiveCall}"
              BackgroundColor="{StaticResource BgWhite}"
              Padding="0">

            <VerticalStackLayout Spacing="12" VerticalOptions="Center"
                                 HorizontalOptions="Center" Padding="32">

                <!-- Logo -->
                <Image Source="kerphone_logo.png"
                       HeightRequest="110" WidthRequest="110"
                       Aspect="AspectFit" HorizontalOptions="Center"
                       Margin="0,0,0,12" />

                <!-- Numero -->
                <Label Text="{Binding RemoteParty}" FontSize="28"
                       FontFamily="OpenSansSemibold"
                       TextColor="{StaticResource TextDark}"
                       HorizontalTextAlignment="Center" />

                <!-- Statut appel -->
                <Label Text="{Binding CallStatus}" FontSize="15"
                       TextColor="{StaticResource KerBlue}"
                       HorizontalTextAlignment="Center" />

                <!-- Duree -->
                <Label Text="{Binding CallDuration}" FontSize="42"
                       FontFamily="OpenSansSemibold"
                       TextColor="{StaticResource TextDark}"
                       HorizontalTextAlignment="Center"
                       Margin="0,8,0,20" />

                <!-- Boutons: Micro + Raccrocher -->
                <HorizontalStackLayout Spacing="16" HorizontalOptions="Center">

                    <!-- Bouton Micro -->
                    <Button Text="{Binding IsMuted, Converter={StaticResource MuteTextConverter}}"
                            BackgroundColor="{StaticResource DialBg}"
                            TextColor="{StaticResource TextDark}"
                            CornerRadius="28"
                            HeightRequest="56" MinimumWidthRequest="130"
                            FontFamily="OpenSansSemibold" FontSize="15"
                            Command="{Binding ToggleMuteCommand}" />

                    <!-- Bouton Raccrocher -->
                    <Button Text="Raccrocher"
                            Style="{StaticResource DangerButton}"
                            Command="{Binding HangupCommand}"
                            x:Name="HangupButton" />

                </HorizontalStackLayout>

            </VerticalStackLayout>
        </Grid>

    </Grid>

</ContentPage>
