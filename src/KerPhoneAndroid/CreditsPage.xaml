<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="KerPhoneAndroid.CreditsPage"
             Title="À propos"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{StaticResource BgWhite}">

    <Grid RowDefinitions="Auto,*,Auto" Padding="0">

        <!-- En-tete -->
        <Grid Grid.Row="0" BackgroundColor="{StaticResource BgHeader}"
              Padding="12,10" ColumnDefinitions="Auto,*,Auto">

            <!-- Fleche retour -->
            <Button Grid.Column="0" Text="&#x2190;"
                    Clicked="OnBackClicked"
                    BackgroundColor="Transparent"
                    TextColor="{StaticResource TextDark}"
                    FontSize="22" WidthRequest="44" HeightRequest="44" />

            <Label Grid.Column="1" Text="À propos"
                   FontSize="18" FontFamily="OpenSansSemibold"
                   TextColor="{StaticResource TextDark}"
                   HorizontalTextAlignment="Center"
                   VerticalOptions="Center" />

            <!-- Espace vide a droite -->
            <BoxView Grid.Column="2" WidthRequest="44" BackgroundColor="Transparent" />
        </Grid>

        <!-- Contenu -->
        <ScrollView Grid.Row="1">
            <VerticalStackLayout Spacing="16" VerticalOptions="Center"
                                 Padding="40,24">

                <!-- Logo -->
                <Image Source="kerphone_logo.png"
                       HeightRequest="100" WidthRequest="100"
                       Aspect="AspectFit"
                       HorizontalOptions="Center" />

                <!-- Titre app -->
                <Label Text="KerPhone"
                       FontSize="30" FontFamily="OpenSansSemibold"
                       TextColor="{StaticResource TextDark}"
                       HorizontalTextAlignment="Center" />

                <Label x:Name="VersionLabel"
                       FontSize="13"
                       TextColor="{StaticResource TextMuted}"
                       HorizontalTextAlignment="Center"
                       Margin="0,-8,0,0" />

                <!-- Description -->
                <Label Text="Softphone SIP simple et léger"
                       FontSize="14"
                       TextColor="{StaticResource TextMedium}"
                       HorizontalTextAlignment="Center"
                       Margin="0,8,0,0" />

                <!-- Separateur -->
                <BoxView HeightRequest="1"
                         BackgroundColor="{StaticResource BorderLight}"
                         Margin="20,8" />

                <!-- Developpe en Bretagne -->
                <Label FontSize="15"
                       TextColor="{StaticResource TextMedium}"
                       HorizontalTextAlignment="Center">
                    <Label.FormattedText>
                        <FormattedString>
                            <Span Text="Développé en Bretagne " />
                            <Span Text="&#x2691;" FontSize="18" />
                        </FormattedString>
                    </Label.FormattedText>
                </Label>

                <!-- Association KerBzh -->
                <VerticalStackLayout Spacing="4" HorizontalOptions="Center" Margin="0,8,0,0">
                    <Label Text="Application développée par l'association"
                           FontSize="13" TextColor="{StaticResource TextMuted}"
                           HorizontalTextAlignment="Center" />
                    <Label Text="KerBzh"
                           FontSize="20" FontFamily="OpenSansSemibold"
                           TextColor="{StaticResource KerBlue}"
                           HorizontalTextAlignment="Center"
                           TextDecorations="Underline">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnKerBzhTapped" />
                        </Label.GestureRecognizers>
                    </Label>
                </VerticalStackLayout>

                <!-- Chef de projet -->
                <VerticalStackLayout Spacing="2" HorizontalOptions="Center" Margin="0,8,0,0">
                    <Label Text="Chef de projet" FontSize="12"
                           TextColor="{StaticResource TextMuted}"
                           HorizontalTextAlignment="Center" />
                    <Label Text="Pierre LEGENDRE" FontSize="16"
                           FontFamily="OpenSansSemibold"
                           TextColor="{StaticResource TextDark}"
                           HorizontalTextAlignment="Center" />
                </VerticalStackLayout>

            </VerticalStackLayout>
        </ScrollView>

        <!-- Pied: lien Support -->
        <VerticalStackLayout Grid.Row="2" Spacing="4" Margin="0,0,0,20">
            <Label Text="Support"
                   FontSize="14" FontFamily="OpenSansSemibold"
                   TextColor="{StaticResource KerBlue}"
                   HorizontalTextAlignment="Center"
                   TextDecorations="Underline">
                <Label.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnEmailTapped" />
                </Label.GestureRecognizers>
            </Label>
            <Label Text="&#x00A9; 2026 KerBzh"
                   FontSize="10" TextColor="{StaticResource TextMuted}"
                   HorizontalTextAlignment="Center" />
        </VerticalStackLayout>

    </Grid>

</ContentPage>
