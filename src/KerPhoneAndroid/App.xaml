<?xml version="1.0" encoding="UTF-8" ?>
<Application xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:KerPhoneAndroid"
             x:Class="KerPhoneAndroid.App">
    <Application.Resources>
        <ResourceDictionary>

            <!-- Convertisseurs -->
            <local:StringToBoolConverter x:Key="StringToBoolConverter" />
            <local:InvertedBoolConverter x:Key="InvertedBoolConverter" />
            <local:MuteTextConverter x:Key="MuteTextConverter" />

            <!-- === THEME CLAIR KerPhone === -->
            <Color x:Key="BgWhite">#FFFFFF</Color>
            <Color x:Key="BgLight">#F0F4F8</Color>
            <Color x:Key="BgCard">#FFFFFF</Color>
            <Color x:Key="BgHeader">#FAFBFC</Color>

            <!-- Bleu KerPhone (du logo) -->
            <Color x:Key="KerBlue">#1565C0</Color>
            <Color x:Key="KerBlueDark">#0D47A1</Color>
            <Color x:Key="KerBlueLight">#E3F2FD</Color>

            <!-- Appel actif - fond sombre -->
            <Color x:Key="CallBgDark">#0A1628</Color>
            <Color x:Key="CallBgMedium">#142A50</Color>

            <!-- Textes -->
            <Color x:Key="TextDark">#1A1A2E</Color>
            <Color x:Key="TextMedium">#555555</Color>
            <Color x:Key="TextMuted">#999999</Color>
            <Color x:Key="TextWhite">#FFFFFF</Color>

            <!-- Accents -->
            <Color x:Key="DangerRed">#E53935</Color>
            <Color x:Key="SuccessGreen">#43A047</Color>
            <Color x:Key="WarningOrange">#FF9800</Color>
            <Color x:Key="BorderLight">#E0E6ED</Color>

            <!-- Couleurs dialpad -->
            <Color x:Key="DialBg">#E8EDF5</Color>
            <Color x:Key="DialText">#1A1A2E</Color>
            <Color x:Key="DialSub">#7A8BA0</Color>

            <!-- Styles globaux -->
            <Style TargetType="Page" ApplyToDerivedTypes="True">
                <Setter Property="BackgroundColor" Value="{StaticResource BgWhite}" />
            </Style>

            <Style TargetType="Label">
                <Setter Property="TextColor" Value="{StaticResource TextDark}" />
                <Setter Property="FontFamily" Value="OpenSansRegular" />
            </Style>

            <Style TargetType="Entry">
                <Setter Property="TextColor" Value="{StaticResource TextDark}" />
                <Setter Property="PlaceholderColor" Value="{StaticResource TextMuted}" />
                <Setter Property="BackgroundColor" Value="{StaticResource BgLight}" />
                <Setter Property="FontFamily" Value="OpenSansRegular" />
                <Setter Property="FontSize" Value="15" />
                <Setter Property="MinimumHeightRequest" Value="48" />
            </Style>

            <!-- Bouton bleu principal -->
            <Style x:Key="PrimaryButton" TargetType="Button">
                <Setter Property="BackgroundColor" Value="{StaticResource KerBlue}" />
                <Setter Property="TextColor" Value="{StaticResource TextWhite}" />
                <Setter Property="FontFamily" Value="OpenSansSemibold" />
                <Setter Property="CornerRadius" Value="12" />
                <Setter Property="HeightRequest" Value="52" />
                <Setter Property="FontSize" Value="17" />
            </Style>

            <!-- Bouton danger rouge -->
            <Style x:Key="DangerButton" TargetType="Button">
                <Setter Property="BackgroundColor" Value="{StaticResource DangerRed}" />
                <Setter Property="TextColor" Value="{StaticResource TextWhite}" />
                <Setter Property="FontFamily" Value="OpenSansSemibold" />
                <Setter Property="CornerRadius" Value="28" />
                <Setter Property="HeightRequest" Value="56" />
                <Setter Property="FontSize" Value="16" />
                <Setter Property="MinimumWidthRequest" Value="140" />
            </Style>

            <!-- Bouton action appel (mute, hold) -->
            <Style x:Key="CallActionButton" TargetType="Button">
                <Setter Property="BackgroundColor" Value="#3A4A6A" />
                <Setter Property="TextColor" Value="{StaticResource TextWhite}" />
                <Setter Property="FontFamily" Value="OpenSansSemibold" />
                <Setter Property="CornerRadius" Value="30" />
                <Setter Property="FontSize" Value="13" />
                <Setter Property="HeightRequest" Value="60" />
                <Setter Property="WidthRequest" Value="60" />
            </Style>

        </ResourceDictionary>
    </Application.Resources>
</Application>
